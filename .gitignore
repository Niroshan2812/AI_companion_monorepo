# ==============================================================================
# This root .gitignore handles exclusions for the entire monorepo, including 
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Java & Maven (Applies to java-gateway/)
# We ignore build outputs and compiled classes to keep the repository clean.
# ------------------------------------------------------------------------------
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Ignore compiled class files and packaged archives
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# ------------------------------------------------------------------------------
# 2. IDE & Editor Files
# We ignore JetBrains IDE folders visible in both the root and java-gateway.
# ------------------------------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
.vscode/

# ------------------------------------------------------------------------------
# 3. Environment & Secrets
# We prevent sensitive data or local environment configurations from being pushed.
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.log

# ------------------------------------------------------------------------------
# 4. OS Generated Files
# We ignore system-specific files that clutter the commit history.
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ------------------------------------------------------------------------------
# 5. Python & AI Inference (Applies to python-inference/)
# ------------------------------------------------------------------------------
# Virtual environments
venv/
env/
ENV/
.env_python/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# gRPC generated files
*_pb2.py
*_pb2_grpc.py
*_pb2.pyi
*_pb2_grpc.pyi